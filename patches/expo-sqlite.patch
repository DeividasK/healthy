+/**
+ * The OPFS pool takes an exclusive access handle on every file of the origin,
+ * so it is only created once a persistent database is needed. A page that
+ * only opens in-memory databases leaves OPFS free for other tabs.
+ */
+async function maybeInitPersistentVfsAsync(): Promise<AccessHandlePoolVFS> {
+  const { sqlite3 } = await maybeInitAsync();
+  _vfsPromise ??= (async () => {
+    const vfs = await AccessHandlePoolVFS.create(VFS_NAME_PERSISTENT, _module);
+    if (vfs == null) {
+      throw new Error('Failed to initialize AccessHandlePoolVFS');
+    }
+    sqlite3.vfs_register(vfs, true);
+    _vfs = vfs;
+    return vfs;
+  })().catch((error) => {
+    _vfsPromise = null;
+    throw error;
+  });
+  return await _vfsPromise;
 }
 
