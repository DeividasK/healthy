diff --git a/dist/cjs.js b/dist/cjs.js
index 7c36cbdd06cc22c92d590be3f87a08a91ca06b40..b4f3c4bdea02d76c60bfe51f63b1a66b48e42abd 100644
--- a/dist/cjs.js
+++ b/dist/cjs.js
@@ -80,10 +80,18 @@ function mergeObject(target, source, options) {
 	var destination = {};
 	if (options.isMergeableObject(target)) {
 		getKeys(target).forEach(function(key) {
+			// Assigning __proto__ would replace the result's prototype.
+			if (key === '__proto__') {
+				return
+			}
 			destination[key] = cloneUnlessOtherwiseSpecified(target[key], options);
 		});
 	}
 	getKeys(source).forEach(function(key) {
+		// Assigning __proto__ would replace the result's prototype.
+		if (key === '__proto__') {
+			return
+		}
 		if (propertyIsUnsafe(target, key)) {
 			return
 		}
